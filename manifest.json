{
  "manifest_version": 3,
  "name": "Outlook Room Finder Extensions",
  "version": "1.0.1",
  "description": "Add practical room-name and availability filters to Outlook Room Finder.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Outlook room finder extensions",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "room-filter-16.png",
      "32": "room-filter-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}